<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Sign-in keeps the back stack so the user returns to the screen that asked for it. -->
    <action
        android:id="@+id/action_global_sign_in"
        app:destination="@id/loginFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out"
        app:launchSingleTop="true" />

    <action
        android:id="@+id/action_global_favorites"
        app:destination="@id/favoritesFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_info"
        app:destination="@id/infoFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_home"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_recovery"
        app:destination="@id/passwordFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true">
        <argument
            android:name="recovery"
            android:defaultValue="true"
            app:argType="boolean" />
    </action>

    <action
        android:id="@+id/action_global_detail"
        app:destination="@id/petDetailFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_public_profile"
        app:destination="@id/publicProfileFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_location_picker"
        app:destination="@id/locationPickerFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_walk_editor"
        app:destination="@id/walkEditorFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_walk_detail"
        app:destination="@id/walkDetailFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_inbox"
        app:destination="@id/inboxFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_chat"
        app:destination="@id/chatFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_walk_history"
        app:destination="@id/walkHistoryFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_walk_route"
        app:destination="@id/walkRouteFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <fragment
        android:id="@+id/walkHistoryFragment"
        android:name="az.miyav.android.ui.WalkHistoryFragment"
        android:label="@string/walk_history_title" />

    <fragment
        android:id="@+id/walkRouteFragment"
        android:name="az.miyav.android.ui.WalkRouteFragment"
        android:label="@string/walk_route_title">
        <argument
            android:name="walkId"
            app:argType="string" />
    </fragment>

    <action
        android:id="@+id/action_global_my_pets"
        app:destination="@id/myPetsListFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_settings"
        app:destination="@id/settingsFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <action
        android:id="@+id/action_global_profile_edit"
        app:destination="@id/profileEditFragment"
        app:enterAnim="@anim/slide_in"
        app:exitAnim="@anim/slide_out"
        app:popEnterAnim="@anim/pop_in"
        app:popExitAnim="@anim/pop_out" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="az.miyav.android.ui.SettingsFragment"
        android:label="@string/settings_title">
        <action
            android:id="@+id/action_settings_to_password"
            app:destination="@id/passwordFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
        <action
            android:id="@+id/action_settings_to_notifications"
            app:destination="@id/notificationsFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
    </fragment>

    <fragment
        android:id="@+id/profileEditFragment"
        android:name="az.miyav.android.ui.ProfileEditFragment"
        android:label="@string/profile_edit" />

    <fragment
        android:id="@+id/myPetsListFragment"
        android:name="az.miyav.android.ui.MyAnimalsFragment"
        android:label="@string/my_pets_title" />

    <fragment
        android:id="@+id/inboxFragment"
        android:name="az.miyav.android.ui.InboxFragment"
        android:label="@string/action_messages" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="az.miyav.android.ui.ChatFragment"
        android:label="@string/action_messages">
        <argument
            android:name="conversationId"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="listingId"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="withUserId"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/walkEditorFragment"
        android:name="az.miyav.android.ui.WalkEditorFragment"
        android:label="@string/wl_editor_title">
        <argument
            android:name="listingId"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/walkDetailFragment"
        android:name="az.miyav.android.ui.WalkDetailFragment"
        android:label="@string/wl_editor_title">
        <argument
            android:name="listingId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/publicProfileFragment"
        android:name="az.miyav.android.ui.PublicProfileFragment"
        android:label="@string/public_profile_title">
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/locationPickerFragment"
        android:name="az.miyav.android.ui.LocationPickerFragment"
        android:label="@string/location_picker_title" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="az.miyav.android.ui.SplashFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="az.miyav.android.ui.LoginFragment"
        android:label="@string/auth_login">
        <argument
            android:name="mode"
            android:defaultValue="login"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="az.miyav.android.ui.FavoritesFragment"
        android:label="@string/favorites_title" />

    <fragment
        android:id="@+id/infoFragment"
        android:name="az.miyav.android.ui.InfoFragment"
        android:label="@string/legal_help">
        <argument
            android:name="kind"
            android:defaultValue="help"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="az.miyav.android.ui.HomeFragment"
        android:label="@string/home_title">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/petDetailFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
        <action
            android:id="@+id/action_home_to_editor"
            app:destination="@id/petEditorFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
        <action
            android:id="@+id/action_home_to_notifications"
            app:destination="@id/notificationsFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
        <action
            android:id="@+id/action_home_to_password"
            app:destination="@id/passwordFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
    </fragment>

    <fragment
        android:id="@+id/petDetailFragment"
        android:name="az.miyav.android.ui.PetDetailFragment"
        android:label="@string/home_title">
        <argument
            android:name="petId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_editor"
            app:destination="@id/petEditorFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/pop_in"
            app:popExitAnim="@anim/pop_out" />
    </fragment>

    <fragment
        android:id="@+id/petEditorFragment"
        android:name="az.miyav.android.ui.PetEditorFragment"
        android:label="@string/pet_create">
        <argument
            android:name="petId"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="az.miyav.android.ui.NotificationsFragment"
        android:label="@string/notifications_title" />

    <fragment
        android:id="@+id/passwordFragment"
        android:name="az.miyav.android.ui.PasswordFragment"
        android:label="@string/auth_change_password">
        <argument
            android:name="recovery"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
</navigation>
