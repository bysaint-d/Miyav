<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_xxl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pastel_note"
        android:padding="@dimen/space_md"
        android:text="@string/walk_consent_body"
        android:textAppearance="@style/TextAppearance.Miyav.Caption"
        android:textColor="@color/text_primary" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Miyav.TextInput.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:hint="@string/pet_species">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/speciesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/petNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:hint="@string/walk_pet_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/petNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLength="60" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/messageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:hint="@string/walk_message"
        app:counterEnabled="true"
        app:counterMaxLength="120"
        app:placeholderText="@string/walk_message_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="120" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
