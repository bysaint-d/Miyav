<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:text="@string/walk_start_title"
            android:textAppearance="@style/TextAppearance.Miyav.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:text="@string/walk_start_subtitle"
            android:textAppearance="@style/TextAppearance.Miyav.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/my_pets_title"
                android:textAppearance="@style/TextAppearance.Miyav.Section" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageButton"
                style="@style/Widget.Miyav.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/walk_manage_pets" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/petList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:minHeight="128dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg" />

        <LinearLayout
            android:id="@+id/jobSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/walk_start_jobs"
                android:textAppearance="@style/TextAppearance.Miyav.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/walk_start_jobs_hint"
                android:textAppearance="@style/TextAppearance.Miyav.Caption" />

            <LinearLayout
                android:id="@+id/jobList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_xl"
            android:hint="@string/walk_message"
            app:placeholderText="@string/walk_message_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_xl"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/walk_privacy_short"
            android:textAppearance="@style/TextAppearance.Miyav.Caption"
            app:drawableStartCompat="@drawable/ic_shield"
            app:drawableTint="@color/brand_mint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_xl"
            android:enabled="false"
            android:minHeight="58dp"
            android:text="@string/walk_start_none"
            app:icon="@drawable/ic_walk"
            app:iconGravity="textStart" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_xl"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/brand_coral"
            app:trackColor="@color/pastel_peach" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
