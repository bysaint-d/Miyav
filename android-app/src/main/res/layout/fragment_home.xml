<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tabHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:elevation="@dimen/elevation_nav"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />

        <FrameLayout
            android:id="@+id/walkButtonArea"
            android:layout_width="88dp"
            android:layout_height="80dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/space_xs"
            android:clipChildren="false"
            android:elevation="16dp"
            android:translationY="-28dp">

            <ImageButton
                android:id="@+id/walkButton"
                android:layout_width="@dimen/walk_fab_size"
                android:layout_height="@dimen/walk_fab_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_walk_fab"
                android:contentDescription="@string/nav_walk"
                android:elevation="@dimen/elevation_fab"
                android:padding="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_walk" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
