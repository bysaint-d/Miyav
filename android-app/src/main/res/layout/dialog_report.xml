<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_xxl">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/reasonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/report_hint"
        app:counterEnabled="true"
        app:counterMaxLength="1500">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reasonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1500"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
