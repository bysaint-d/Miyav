<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xxxl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_account"
                android:textAppearance="@style/TextAppearance.Miyav.Section" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/myPetsButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/my_pets_title"
                        app:icon="@drawable/ic_paw" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/passwordButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_change_password"
                        app:icon="@drawable/ic_shield" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/blockedButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/blocked_list"
                        app:icon="@drawable/ic_person" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_section_activity"
                android:textAppearance="@style/TextAppearance.Miyav.Section" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/messagesButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_messages"
                        app:icon="@drawable/ic_chat" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notificationsButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_notifications"
                        app:icon="@drawable/ic_bell" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/favoritesButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/favorites_title"
                        app:icon="@drawable/ic_heart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/profile_language"
                android:textAppearance="@style/TextAppearance.Miyav.Section" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/languageGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/languageAz"
                    style="@style/Widget.Miyav.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/language_az" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/languageEn"
                    style="@style/Widget.Miyav.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/language_en" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/languageRu"
                    style="@style/Widget.Miyav.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/language_ru" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/legal_section"
                android:textAppearance="@style/TextAppearance.Miyav.Section" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/helpButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/legal_help"
                        app:icon="@drawable/ic_info" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/termsButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/legal_terms"
                        app:icon="@drawable/ic_document" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/privacyButton"
                        style="@style/Widget.Miyav.Button.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/legal_privacy"
                        app:icon="@drawable/ic_shield" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.Miyav.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:text="@string/auth_logout" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteAccountButton"
                style="@style/Widget.Miyav.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/account_delete"
                android:textColor="@color/error" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:indeterminate="true"
                android:visibility="invisible"
                app:indicatorColor="@color/brand_coral"
                app:trackColor="@color/pastel_peach" />

            <TextView
                android:id="@+id/versionView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Miyav.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
