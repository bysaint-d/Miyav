<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/wl_editor_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xl"
                android:paddingEnd="@dimen/space_xl"
                android:paddingBottom="@dimen/space_xxxl">

                <LinearLayout
                    android:id="@+id/stageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_pastel_note"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/stageIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_round_surface"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stageTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/stageBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/stageHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Miyav.Caption"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="72dp"
                                android:layout_height="72dp">

                                <TextView
                                    android:id="@+id/speciesBadge"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_map_card"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:textSize="32sp" />

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/petPhotoView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/photo_open"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"
                                    app:shapeAppearanceOverlay="@style/Shape.Miyav.Photo" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/titleView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Miyav.Title" />

                                <TextView
                                    android:id="@+id/statusView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:background="@drawable/bg_map_card"
                                    android:backgroundTint="@color/pastel_mint"
                                    android:paddingStart="@dimen/space_sm"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="@dimen/space_sm"
                                    android:paddingBottom="2dp"
                                    android:textAppearance="@style/TextAppearance.Miyav.Badge" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/priceView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:textAppearance="@style/TextAppearance.Miyav.Title"
                            android:textColor="@color/brand_coral" />

                        <TextView
                            android:id="@+id/totalView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Miyav.Body" />

                        <TextView
                            android:id="@+id/askedView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Miyav.Caption"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/timeView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:textAppearance="@style/TextAppearance.Miyav.Body" />

                        <TextView
                            android:id="@+id/placeView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Miyav.Body"
                            app:drawableStartCompat="@drawable/ic_location"
                            app:drawableTint="@color/brand_coral" />

                        <TextView
                            android:id="@+id/notesView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:textAppearance="@style/TextAppearance.Miyav.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wl_owner"
                            android:textAppearance="@style/TextAppearance.Miyav.Section" />

                        <TextView
                            android:id="@+id/ownerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:minHeight="44dp"
                            android:textAppearance="@style/TextAppearance.Miyav.Body"
                            app:drawableStartCompat="@drawable/ic_person"
                            app:drawableTint="@color/brand_coral" />

                        <LinearLayout
                            android:id="@+id/walkerSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_md"
                                android:text="@string/wl_walker"
                                android:textAppearance="@style/TextAppearance.Miyav.Section" />

                            <TextView
                                android:id="@+id/walkerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:background="?attr/selectableItemBackground"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:minHeight="44dp"
                                android:textAppearance="@style/TextAppearance.Miyav.Body"
                                app:drawableStartCompat="@drawable/ic_walk"
                                app:drawableTint="@color/brand_coral" />

                            <TextView
                                android:id="@+id/walkerRatingView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Miyav.Caption"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/reviewView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_map_card"
                                android:backgroundTint="@color/surface_muted"
                                android:padding="@dimen/space_md"
                                android:textAppearance="@style/TextAppearance.Miyav.Body"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/offerSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/offerPriceLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/wl_your_price">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/offerPriceInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:maxLength="6" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/offerLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:hint="@string/wl_offer_message"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/offerInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLength="500"
                                android:minLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/offerButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/wl_offer"
                            app:icon="@drawable/ic_walk" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/myOfferSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/myOfferView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miyav.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/withdrawButton"
                        style="@style/Widget.Miyav.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/wl_offer_withdraw" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatButton"
                    style="@style/Widget.Miyav.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/wl_message"
                    android:visibility="gone"
                    app:icon="@drawable/ic_chat" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/offersSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            android:id="@+id/offersTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Miyav.Section" />

                        <TextView
                            android:id="@+id/offersEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/wl_offers_empty"
                            android:textAppearance="@style/TextAppearance.Miyav.Caption" />

                        <LinearLayout
                            android:id="@+id/offersList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/completeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/wl_complete"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/wl_rate_walker"
                    android:visibility="gone"
                    app:icon="@drawable/ic_star" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editButton"
                    style="@style/Widget.Miyav.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/wl_edit"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.Miyav.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/wl_cancel"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:indicatorColor="@color/brand_coral"
                    app:trackColor="@color/pastel_peach" />

                <TextView
                    android:id="@+id/messageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Miyav.Caption" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/state"
            layout="@layout/view_state" />
    </FrameLayout>
</LinearLayout>
