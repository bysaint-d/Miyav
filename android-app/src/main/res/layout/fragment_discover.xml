<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_md">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/space_md"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_listings"
            android:textAppearance="@style/TextAppearance.Miyav.Title"
            android:textSize="@dimen/discover_title_size" />

        <ImageButton
            android:id="@+id/favoritesButton"
            android:layout_width="@dimen/discover_action_size"
            android:layout_height="@dimen/discover_action_size"
            android:layout_marginEnd="@dimen/discover_action_gap"
            android:background="@drawable/bg_map_card"
            android:contentDescription="@string/favorites_title"
            android:elevation="2dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/brand_coral" />

        <FrameLayout
            android:layout_width="@dimen/discover_action_size"
            android:layout_height="@dimen/discover_action_size"
            android:layout_marginEnd="@dimen/discover_action_gap">

            <ImageButton
                android:id="@+id/messagesButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_map_card"
                android:contentDescription="@string/action_messages"
                android:elevation="2dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/brand_coral" />

            <View
                android:id="@+id/messagesDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_unread_dot"
                android:elevation="3dp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/notificationsButton"
            android:layout_width="@dimen/discover_action_size"
            android:layout_height="@dimen/discover_action_size"
            android:background="@drawable/bg_map_card"
            android:contentDescription="@string/action_notifications"
            android:elevation="2dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/brand_coral" />
    </LinearLayout>

    <TextView
        android:id="@+id/greetingView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/space_xl"
        android:textAppearance="@style/TextAppearance.Miyav.Caption" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_xl"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeWalks"
            style="@style/Widget.Miyav.Button.Segment.Compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_walks"
            app:icon="@drawable/ic_walk"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeAdoption"
            style="@style/Widget.Miyav.Button.Segment.Compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_adoption"
            app:icon="@drawable/ic_paw"
            app:iconGravity="textStart"
            app:iconSize="18dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_xl"
        android:hint="@string/search_hint"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/brand_coral">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="60" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_xl"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/cityLayout"
            style="@style/Widget.Miyav.TextInput.Dropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="@string/filter_city">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/cityFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Miyav.TextInput.Dropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="@string/filter_species">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/speciesFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_xl"
        app:singleLine="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/nearbyChip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/location_use"
            app:chipBackgroundColor="@color/chip_nearby"
            app:chipIcon="@drawable/ic_location"
            app:chipIconTint="@color/brand_coral"
            app:chipIconVisible="true"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/filtersChip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filters_button"
            app:chipBackgroundColor="@color/chip_nearby"
            app:chipIcon="@drawable/ic_tune"
            app:chipIconTint="@color/brand_coral"
            app:chipIconVisible="true"
            app:chipStrokeWidth="0dp" />
    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/petList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="15dp"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="15dp"
                    android:paddingBottom="96dp" />

                <az.miyav.android.ui.widget.ShimmerLayout
                    android:id="@+id/skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/skeleton_pet_card" />

                        <include layout="@layout/skeleton_pet_card" />

                        <include layout="@layout/skeleton_pet_card" />
                    </LinearLayout>
                </az.miyav.android.ui.widget.ShimmerLayout>

                <include
                    android:id="@+id/state"
                    layout="@layout/view_state" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/createButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_lg"
            android:contentDescription="@string/pet_create"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/brand_coral"
            app:tint="@color/text_on_brand" />
    </FrameLayout>
</LinearLayout>
