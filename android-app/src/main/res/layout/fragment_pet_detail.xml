<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xxxl">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_gallery_height">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/photoList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pastel_peach"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/photoCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:layout_marginBottom="36dp"
                    android:background="@drawable/bg_map_card"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="@style/TextAppearance.Miyav.Badge" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_sheet_top"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xl"
                android:paddingTop="@dimen/space_xxl"
                android:paddingEnd="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/titleView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Miyav.Title" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/locationLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Miyav.Caption"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="@color/brand_coral" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/factChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:chipSpacingHorizontal="@dimen/space_sm" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/detail_about"
                    android:textAppearance="@style/TextAppearance.Miyav.Section" />

                <TextView
                    android:id="@+id/bodyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Miyav.Body" />

                <TextView
                    android:id="@+id/careView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_pastel_note"
                    android:padding="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.Miyav.Caption"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/locationSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:text="@string/pet_section_location"
                        android:textAppearance="@style/TextAppearance.Miyav.Section" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/map_preview_height"
                        android:layout_marginTop="@dimen/space_sm">

                        <org.osmdroid.views.MapView
                            android:id="@+id/mapPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/location_approx"
                            android:textAppearance="@style/TextAppearance.Miyav.Caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openMapButton"
                            style="@style/Widget.Miyav.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/location_open_map"
                            app:icon="@drawable/ic_map" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/detail_publisher"
                    android:textAppearance="@style/TextAppearance.Miyav.Section" />

                <az.miyav.android.ui.widget.ShimmerLayout
                    android:id="@+id/publisherSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm">

                    <include layout="@layout/skeleton_publisher" />
                </az.miyav.android.ui.widget.ShimmerLayout>

                <include
                    android:id="@+id/publisher"
                    layout="@layout/view_publisher_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/otherSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:text="@string/detail_other_listings"
                        android:textAppearance="@style/TextAppearance.Miyav.Section" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/otherList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/applySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/messageLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/adoption_message"
                        app:counterEnabled="true"
                        app:counterMaxLength="2000"
                        app:helperText="@string/adoption_message_helper">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/messageInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="2000"
                            android:minLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/applyButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/adoption_submit" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ownerBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:text="@string/pet_owner_badge"
                    android:textAppearance="@style/TextAppearance.Miyav.Section"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editButton"
                    style="@style/Widget.Miyav.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/pet_edit"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:indicatorColor="@color/brand_coral"
                    app:trackColor="@color/pastel_peach" />

                <TextView
                    android:id="@+id/messageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Miyav.Caption" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <az.miyav.android.ui.widget.ShimmerLayout
        android:id="@+id/skeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/skeleton_detail" />
    </az.miyav.android.ui.widget.ShimmerLayout>

    <include
        android:id="@+id/state"
        layout="@layout/view_state" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_surface"
            android:contentDescription="@string/action_back"
            android:elevation="3dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/bg_round_surface"
            android:contentDescription="@string/favorites_add"
            android:elevation="3dp"
            android:src="@drawable/ic_heart"
            android:visibility="gone"
            app:tint="@color/brand_coral" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_surface"
            android:contentDescription="@string/share_listing"
            android:elevation="3dp"
            android:src="@drawable/ic_share"
            android:visibility="gone"
            app:tint="@color/brand_coral" />
    </LinearLayout>
</FrameLayout>
