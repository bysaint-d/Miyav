<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:contentDescription="@null"
        android:elevation="4dp"
        android:src="@drawable/ic_location"
        app:tint="@color/brand_coral" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_surface"
            android:contentDescription="@string/action_back"
            android:elevation="3dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:background="@drawable/bg_map_card"
            android:elevation="3dp"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/location_picker_title"
            android:textAppearance="@style/TextAppearance.Miyav.Headline" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/myLocationButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="220dp"
        android:background="@drawable/bg_round_surface"
        android:contentDescription="@string/walk_locate_me"
        android:elevation="4dp"
        android:src="@drawable/ic_my_location"
        app:tint="@color/brand_coral" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:id="@+id/placeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Miyav.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/location_picker_hint"
                android:textAppearance="@style/TextAppearance.Miyav.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/pet_location_privacy"
                android:textAppearance="@style/TextAppearance.Miyav.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/location_picker_confirm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="end"
                android:text="@string/map_attribution"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
