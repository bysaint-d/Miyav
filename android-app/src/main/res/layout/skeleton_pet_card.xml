<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_xs"
    android:layout_marginTop="@dimen/space_md"
    android:layout_marginEnd="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_photo_height"
            android:background="@color/skeleton_base" />

        <View
            android:layout_width="160dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="220dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
