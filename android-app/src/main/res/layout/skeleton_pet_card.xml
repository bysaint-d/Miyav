<?xml version="1.0" encoding="utf-8"?>
<!-- One row of two placeholder tiles, matching the listing grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_weight="1"
        app:cardCornerRadius="@dimen/radius_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/tile_photo_height"
                android:background="@color/skeleton_base" />

            <View
                android:layout_width="96dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="120dp"
                android:layout_height="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_weight="1"
        app:cardCornerRadius="@dimen/radius_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/tile_photo_height"
                android:background="@color/skeleton_base" />

            <View
                android:layout_width="96dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="120dp"
                android:layout_height="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
