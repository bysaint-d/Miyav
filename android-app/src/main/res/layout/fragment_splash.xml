<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <View
        android:id="@+id/haloView"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_round_surface"
        android:backgroundTint="@color/pastel_peach" />

    <ImageView
        android:id="@+id/logoView"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_mark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="124dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/nameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.3"
            android:text="@string/app_name"
            android:textColor="@color/brand_coral"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/taglineView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/brand_tagline"
            android:textAppearance="@style/TextAppearance.Miyav.Caption"
            android:textColor="@color/brand_mint" />
    </LinearLayout>
</FrameLayout>
