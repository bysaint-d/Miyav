<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- MIYAV admin console: sidebar navigation on the left, the selected section on the right. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="az.miyav.desktop.HomeController" styleClass="screen">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="252" minWidth="232" spacing="2"/>
    </left>
    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets top="26" right="28" bottom="12" left="28"/>
                </padding>
                <VBox spacing="2">
                    <Label fx:id="title" styleClass="page-title"/>
                    <Label fx:id="subtitle" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton" onAction="#onRefresh" styleClass="ghost" mnemonicParsing="false"/>
            </HBox>
            <ScrollPane fx:id="scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <StackPane fx:id="content">
                    <padding>
                        <Insets top="8" right="28" bottom="28" left="28"/>
                    </padding>
                </StackPane>
            </ScrollPane>
            <Label fx:id="status" styleClass="status-bar" maxWidth="Infinity" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
