# Environment variables for CI or shells. Copy to .env (gitignored) only for local tooling.
# Values here are placeholders; never commit real values.

# Public client configuration (used when local.properties is absent, e.g. CI)
MIYAV_SUPABASE_URL=https://<project-ref>.supabase.co
MIYAV_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<value>

# Release signing (CI). The keystore file itself must come from a secure secret store.
MIYAV_UPLOAD_STORE_FILE=
MIYAV_UPLOAD_STORE_PASSWORD=
MIYAV_UPLOAD_KEY_ALIAS=
MIYAV_UPLOAD_KEY_PASSWORD=

# Optional live integration test (android-app LiveSupabaseFlowTest). Use dedicated QA accounts only.
MIYAV_IT_OWNER_EMAIL=
MIYAV_IT_OWNER_PASSWORD=
MIYAV_IT_APPLICANT_EMAIL=
MIYAV_IT_APPLICANT_PASSWORD=
